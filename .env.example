DATABASE_URL=postgresql://postgres:postgres@localhost:5432/everwealth?sslmode=disable
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=false
PLAID_CLIENT_ID=replace-with-your-plaid-client-id
PLAID_SECRET=replace-with-your-plaid-secret
PLAID_ENV=sandbox
PLAID_WEBHOOK_HANDLER_URL=https://your-app-domain/transactions/hooks/plaid

