{
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./everwealth/static/input.css -o ./everwealth/static/styles.css --minify",
    "build:js": "esbuild ./everwealth/static/src/app.js --bundle --minify --outfile=./everwealth/static/scripts/app.js",
    "dev:css": "tailwindcss -i ./everwealth/static/input.css -o ./everwealth/static/styles.css --watch"
  },
  "devDependencies": {
    "daisyui": "^4.12.24",
    "esbuild": "^0.25.12",
    "lucide": "^0.468.0",
    "tailwindcss": "^3.4.0"
  }
}
